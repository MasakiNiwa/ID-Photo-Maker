{
  "name": "id-photo-maker",
  "private": true,
  "version": "0.1.0",
  "description": "証明写真 ID Photo Maker — コンビニ印刷や自宅印刷用の証明写真データを作るWebアプリ",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "licenses": "node scripts/gen-licenses.mjs",
    "predev": "npm run licenses",
    "dev": "vite",
    "prebuild": "npm run licenses",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run licenses",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "lucide-react": "^1.70.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
